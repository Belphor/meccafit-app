# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional se usar publishable acima
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de ignição da Forja — SOMENTE server-side (nunca NEXT_PUBLIC_)
FORGE_KEY=

# Apenas server-side — nunca expor no client
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: apply de migrations SQL (scripts/apply-*.mjs e CI ARGOS auto-apply)
# Supabase Dashboard → Project Settings → Database → Database password
SUPABASE_DB_PASSWORD=

# Cardio de teste: meta 2 min em vez de 30 min (somente dev/staging)
NEXT_PUBLIC_CARDIO_TEST_MODE=1

# Convite dev: token "dev" funciona automaticamente só com npm run dev (NODE_ENV=development).
# NÃO use INVITE_DEV_BYPASS em produção.
